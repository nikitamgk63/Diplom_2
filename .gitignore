# Игнорировать всё в target кроме Allure отчетов
target/*
!target/allure-report/
!target/allure-results/

# Исключения для Maven
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Allure настройки (игнорируем локальную папку .allure)
.allure/

